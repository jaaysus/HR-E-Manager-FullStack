# Copy this file to .env for local development. Do not commit .env.
# In PowerShell, load these into the current process with:
# Get-Content .env | Where-Object { $_ -and -not $_.StartsWith('#') } | ForEach-Object { $name, $value = $_ -split '=', 2; Set-Item -Path "Env:$name" -Value $value }

# Generate a secure key with:
# [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(64))
Authentication__Jwt__SigningKey=REPLACE_WITH_A_64_BYTE_BASE64_KEY
ASPNETCORE_ENVIRONMENT=Development

# First local administrator. The application creates this account once after migrations are applied.
InitialAdmin__Email=admin@example.com
InitialAdmin__Password=REPLACE_WITH_A_12_PLUS_CHARACTER_PASSWORD
InitialAdmin__FullName=HR Administrator
