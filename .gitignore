# Platform-managed agentplat state, not project source. In the
# client-initiated single-repo workspace layout (make's `Path: "."` spec) the
# repo root IS the workspace root, so these land inside this repo rather than
# beside it.
/.plugins/
/.opencode-skills/

# .NET build output and local IDE state.
**/bin/
**/obj/
.vs/
*.user
*.suo

# Development-only imported files; retain the directory placeholder.
/backend/uploads/*
!/backend/uploads/.gitkeep

# Local ASP.NET Core data-protection keys.
/backend/DataProtectionKeys/

# Local administrator bootstrap state; regenerate after resetting the database.
/backend/identity-bootstrap.json
/backend/identity-bootstrap.json.tmp

# Disposable copy of the external demo used by the browser comparison.
/artifacts/demo-comparison/reference/
